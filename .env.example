# Copy to .env and fill in real values — never commit .env

# Shared
DATABASE_URL=postgresql://user:password@localhost:5432/perf_marketing

# Pipelines (Python)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=

# Ad account sync list (JSON) — which accounts to pull in sync_ad_platforms.py
# Example: [{"platform":"google_ads","external_id":"123-456-7890"},{"platform":"meta","external_id":"act_987654321"}]
SYNC_ACCOUNTS=[]

# Slack (Native Ads pipeline)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=C09FCDHFGCU
# Default landing page URL applied to all native ad creatives
NATIVE_ADS_LANDING_URL=

# GetKlar (Daily Spend Report pipeline)
# GETKLAR_API_TOKEN is for the data-import API (open-api.getklar.com) — used elsewhere.
# GETKLAR_REFRESH_TOKEN is the SEPARATE token for the Attribution API.
# Obtain it from: Klar Frontend → Store Settings → Attribution API
GETKLAR_REFRESH_TOKEN=
GETKLAR_TEMPLATE_URL=
# MS Teams incoming webhook URL for the daily spend report.
# If unset, the report is printed to stdout only.
TEAMS_WEBHOOK_URL=

# Outbrain Amplify (Native Ads uploader — GRO-14)
OUTBRAIN_API_KEY=
OUTBRAIN_ACCOUNT_ID=
OUTBRAIN_TEMPLATE_CAMPAIGN_ID=

# Taboola Backstage (Native Ads uploader — GRO-14)
TABOOLA_CLIENT_ID=
TABOOLA_CLIENT_SECRET=
TABOOLA_ACCOUNT_ID=
TABOOLA_TEMPLATE_CAMPAIGN_ID=

# Dashboard (Next.js)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
